# Secrets for the sosh containers (services.sosh.environmentFile). Keep the
# real one root-only and out of git.

# openssl rand -base64 48 | tr -d '\n'
SECRET_KEY_BASE=
# openssl rand -hex 24 (Postgres takes it at first start; the server uses it too)
POSTGRES_PASSWORD=

# Email for sign-up and password codes. Without SMTP_HOST they're only logged.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# MAIL_FROM=no-reply@makeavoy.com
# MAIL_FROM_NAME=sosh

# The oldest apps this server talks to; older ones are told to update (and
# can't sign in) until they do. Unset: any. Raise them when a release
# changes something old apps can't handle. See Sosh.Clients.
# SOSH_MIN_ANDROID=0.3.0
# SOSH_MIN_DESKTOP=0.3.0
# Where "Get the new version" goes (default: the GitHub releases page).
# SOSH_DOWNLOAD_URL=https://github.com/Auxnon/sosh/releases/latest
