# sosh client recipes (https://github.com/casey/just). Run `just` to list.
#
# The client is a Petrichor64 game: scripts/ + assets/ here, run by the engine
# on desktop, or packed into game.game.png and served by Phoenix to the web
# build of the engine. Networking needs an engine built with the `ws` feature
# (the web build always has it).

# Petrichor64 checkout to build the engine from. The client needs feat/polish
# or newer (tilesets, and Tab and punctuation keys for typing emails), which
# the petrichor64-ws worktree has checked out; without it, ~/projects/petrichor64.
p64_ws := home_directory() / "projects/petrichor64-ws"
p64 := env_var_or_default("P64", if path_exists(p64_ws) == "true" { p64_ws } else { home_directory() / "projects/petrichor64" })
# Engine binary for desktop runs and packing; must be built with `ws`.
chor := env_var_or_default("CHOR", p64 / "target/release/petrichor64")
server := justfile_directory() / "../server"
# Container engine: podman if installed, else docker (macOS); or set CTR.
ctr := env_var_or_default("CTR", `command -v podman >/dev/null 2>&1 && echo podman || echo docker`)
static := server / "priv/static"

default:
    @just --list

# Regenerate models and textures in assets/ (needs Pillow).
assets:
    python3 tools/gen_assets.py

# Build the desktop engine with websocket support.
engine:
    cd {{p64}} && cargo build --release --features ws

# Run the client as a desktop app (start the server first: `just serve`).
desktop:
    {{chor}} {{justfile_directory()}}

# Pack the game into the bundle the web build loads from /game.game.png.
pack:
    mkdir -p {{static}}
    {{chor}} pack {{justfile_directory()}} {{static}}/game.game.png

# Build the engine for the browser and install it into Phoenix's priv/static.
web-engine:
    cd {{p64}} && wasm-pack build synth --release --target web --out-dir ../web/synth \
        -- --no-default-features --features worklet
    cd {{p64}} && trunk build --release
    mkdir -p {{static}}
    cp {{p64}}/web/dist/* {{static}}/
    cp web/gamepad.js {{static}}/
    perl -pi -e 's#</body>#  <script src="/gamepad.js"></script>\n  </body>#' {{static}}/index.html
    @echo "web engine installed to {{static}}"

# Everything the web client needs: engine + packed game.
web: web-engine pack

# Start Postgres for world storage on :5442 (podman or docker).
# Resumes it if paused, starts it if stopped, makes it if missing.
db:
    #!/usr/bin/env sh
    case "$({{ctr}} inspect -f '{{{{.State.Status}}' sosh-pg 2>/dev/null)" in
        running) echo "sosh-pg already running" ;;
        paused) {{ctr}} unpause sosh-pg ;;
        "") {{ctr}} run -d --name sosh-pg -p 5442:5432 -e POSTGRES_PASSWORD=postgres \
                -v sosh_pgdata:/var/lib/postgresql/data postgres:17 ;;
        *) {{ctr}} start sosh-pg ;;
    esac

# Start the Phoenix server on :4000 (serves the web client too). Needs `just db`.
# Uses a local `mix` if there is one, otherwise runs in a container.
serve:
    #!/usr/bin/env sh
    set -e
    cd {{server}}
    if command -v mix >/dev/null; then
        mix ecto.create --quiet && mix ecto.migrate && exec mix phx.server
    fi
    {{ctr}} image inspect sosh-elixir >/dev/null 2>&1 || {{ctr}} build -t sosh-elixir -f Containerfile.dev .
    {{ctr}} rm -f sosh-dev >/dev/null 2>&1 || true
    tty=; [ -t 0 ] && tty=-t
    # Linux shares the host's network; Docker Desktop (macOS) can't, so publish
    # :4000 and reach Postgres through host.docker.internal instead.
    if [ "$(uname)" = Darwin ]; then
        net="-p 4000:4000 -e DB_HOST=host.docker.internal"
    else
        net="--network host"
    fi
    # SELinux (Fedora and the like) needs the source mount relabelled: shared
    # (:z), so test containers mounting it too don't lock this one out.
    label=; command -v selinuxenabled >/dev/null && selinuxenabled && label=:z
    exec {{ctr}} run --rm -i $tty --name sosh-dev $net \
        -v {{server}}:/app$label -v sosh_deps:/app/deps -v sosh_build_dev:/app/_build \
        sosh-elixir sh -c 'mix deps.get && mix ecto.create --quiet && mix ecto.migrate && mix phx.server'

# The Android app (android/): build the debug APK.
android:
    cd {{justfile_directory()}}/../android && ./gradlew assembleDebug

# Build and install the Android app on the connected device or emulator.
android-install:
    cd {{justfile_directory()}}/../android && ./gradlew installDebug

# Install the Android app on the phone plugged in over USB (or a running
# emulator), then say which server address to give it.
install:
    #!/usr/bin/env sh
    set -e
    command -v adb >/dev/null || { echo "adb not found: install Android platform-tools"; exit 1; }
    adb start-server >/dev/null 2>&1
    devices=$(adb devices | awk 'NR>1 && $2=="device"' | wc -l)
    if [ "$devices" -eq 0 ]; then
        adb devices | awk 'NR>1 && $2=="unauthorized" {f=1} END {exit !f}' \
            && echo "Accept the \"Allow USB debugging?\" prompt on the phone, then run this again." \
            || echo "No phone found: plug it in with USB debugging on (Settings > About phone > tap Build number 7 times, then Developer options > USB debugging)."
        exit 1
    fi
    cd {{justfile_directory()}}/../android && ./gradlew installDebug
    adb shell monkey -p app.sosh -c android.intent.category.LAUNCHER 1 >/dev/null 2>&1 || true
    ip=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<NF;i++) if($i=="src") print $(i+1)}')
    [ -n "$ip" ] || ip=$(ipconfig getifaddr en0 2>/dev/null || true)
    echo
    echo "Installed. With \`just serve\` running, tap the server address under the"
    echo "sign-in form and enter: http://${ip:-<this computer's LAN address>}:4000"
    echo "(an emulator can keep the default, http://10.0.2.2:4000)"

# The Android app's tests: its network code and models against the dev
# server (`just serve` first; they're skipped without one).
android-test:
    cd {{justfile_directory()}}/../android && ./gradlew testDebugUnitTest
