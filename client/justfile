# sosh client recipes (https://github.com/casey/just). Run `just` to list.
#
# The client is a Petrichor64 game: scripts/ + assets/ here, run by the engine
# on desktop, or packed into game.game.png and served by Phoenix to the web
# build of the engine. Networking needs an engine built with the `ws` feature
# (the web build always has it).

# Petrichor64 checkout to build the engine from. The client needs the engine's
# feat/tilesets branch (main plus tileset()), checked out as the
# petrichor64-ws worktree until it's merged; then drop the worktree default.
p64_ws := home_directory() / "projects/petrichor64-ws"
p64 := env_var_or_default("P64", if path_exists(p64_ws) == "true" { p64_ws } else { home_directory() / "projects/petrichor64" })
# Engine binary for desktop runs and packing; must be built with `ws`.
chor := env_var_or_default("CHOR", p64 / "target/release/petrichor64")
server := justfile_directory() / "../server"
static := server / "priv/static"

default:
    @just --list

# Regenerate models and textures in assets/ (needs Pillow).
assets:
    python3 tools/gen_assets.py

# Build the desktop engine with websocket support.
engine:
    cd {{p64}} && cargo build --release --features ws

# Run the client as a desktop app (start the server first: `just serve`).
desktop:
    {{chor}} {{justfile_directory()}}

# Pack the game into the bundle the web build loads from /game.game.png.
pack:
    mkdir -p {{static}}
    {{chor}} pack {{justfile_directory()}} {{static}}/game.game.png

# Build the engine for the browser and install it into Phoenix's priv/static.
web-engine:
    cd {{p64}} && wasm-pack build synth --release --target web --out-dir ../web/synth \
        -- --no-default-features --features worklet
    cd {{p64}} && trunk build --release
    mkdir -p {{static}}
    cp {{p64}}/web/dist/* {{static}}/
    @echo "web engine installed to {{static}}"

# Everything the web client needs: engine + packed game.
web: web-engine pack

# Start Postgres for world storage on :5442 (podman; docker works the same).
db:
    podman start sosh-pg 2>/dev/null || podman run -d --name sosh-pg -p 5442:5432 \
        -e POSTGRES_PASSWORD=postgres -v sosh_pgdata:/var/lib/postgresql/data postgres:17

# Start the Phoenix server on :4000 (serves the web client too). Needs `just db`.
# Uses a local `mix` if there is one, otherwise runs in a container.
serve:
    #!/usr/bin/env sh
    set -e
    cd {{server}}
    if command -v mix >/dev/null; then
        mix ecto.create --quiet && mix ecto.migrate && exec mix phx.server
    fi
    podman image exists sosh-elixir || podman build -t sosh-elixir -f Containerfile.dev .
    podman rm -f sosh-dev >/dev/null 2>&1 || true
    tty=; [ -t 0 ] && tty=-t
    exec podman run --rm -i $tty --name sosh-dev --network host \
        -v {{server}}:/app:Z -v sosh_deps:/app/deps -v sosh_build_dev:/app/_build \
        sosh-elixir sh -c 'mix deps.get && mix ecto.create --quiet && mix ecto.migrate && mix phx.server'
